# Local development
DEBUG=True
SECRET_KEY=replace-this-with-a-new-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional PostgreSQL. Leave empty to use local db.sqlite3.
DATABASE_URL=

# Optional Cloudinary for uploaded PDFs.
CLOUDINARY_URL=

# Optional SMTP email. Without these, reset emails print in the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional command: python manage.py create_default_admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running-the-command
